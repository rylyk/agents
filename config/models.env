# Which model runs each station (PROPOSAL.md §2.5). This file is the only place models are named;
# playbooks and scripts refer to stations. Sourced by bin/station.
#
# Format: STATION_<NAME>="<backend>:<model>"
#   backend claude  -> Claude Code on the subscription; model is an alias (opus, sonnet, haiku) or a full ID
#   backend ollama  -> Claude Code pointed at the local Ollama server; model is an Ollama model name

STATION_SHAPE="claude:opus"              # ① grill → spec → tickets, owner live. Use sonnet if the Pro plan doesn't offer opus
STATION_BUILD="ollama:qwen3.6-agent"     # ② builder. qwen3.6-agent = qwen3.6:35b-a3b with num_ctx 65536 (see comms/002)
STATION_BUILD_ESCALATE="claude:sonnet"   # fresh builder session after 2 local bounces
STATION_VERIFY="claude:sonnet"           # ③ clean-context verifier
STATION_VERIFY_HIGH="claude:opus"        # ③ spec-level review and autonomy-line areas
STATION_LEARN_EXTRACT="ollama:qwen3.6-agent"  # ⑤ transcript first pass (same model as the builder, so no VRAM swap)
STATION_LEARN_SYNTH="claude:opus"        # ⑤ retro synthesis, wiki lint decisions
STATION_SMALL="claude:haiku"             # progress comments, commit messages, labels

OLLAMA_URL="http://127.0.0.1:11434"

# Held for the whole of a local-model session; the machine runs one GPU job at a time.
# TODO(comms/002): replace with the lock the video pipeline already uses.
GPU_LOCK="${XDG_RUNTIME_DIR:-/tmp}/gpu.lock"
